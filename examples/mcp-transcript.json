        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "tools": [
            {"name": "generate_start", "description": "Start a generation session from a config object; returns session_id and totals.", "inputSchema": {"type": "object", "properties": {"config": {"type": "object", "properties": {"categories": {"type": "array", "items": {"type": "string"}}, "exclude": {"type": "array", "items": {"type": "string"}}, "include": {"type": "array", "items": {"type": "string"}}, "order": {"type": "string", "enum": ["sequential", "permuted", "blocks"]}, "prefix_len": {"type": "integer", "maximum": 32, "minimum": 8}, "preset": {"type": "string", "enum": ["public", "private", "all", "public+private"]}, "seed": {"type": "integer"}, "shard": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"}}}}, "required": ["config"]}},
            {"name": "generate_next", "description": "Pull the next batch of items (addresses or /prefix blocks depending on order mode).", "inputSchema": {"type": "object", "properties": {"count": {"type": "integer", "maximum": 100000, "minimum": 1}, "session_id": {"type": "string"}}, "required": ["session_id", "count"]}},
            {"name": "generate_status", "description": "Get session progress: cursor, total, remaining, percent.", "inputSchema": {"type": "object", "properties": {"session_id": {"type": "string"}}, "required": ["session_id"]}},
            {"name": "generate_pause", "description": "Pause a session and return its checkpoint (JSON). The session stays in memory until closed.", "inputSchema": {"type": "object", "properties": {"session_id": {"type": "string"}}, "required": ["session_id"]}},
            {"name": "generate_resume", "description": "Resume a session from a checkpoint previously returned by generate_pause or exported.", "inputSchema": {"type": "object", "properties": {"checkpoint": {"type": "object"}}, "required": ["checkpoint"]}},
            {"name": "ranges_list", "description": "List the CIDR blocks for given categories.", "inputSchema": {"type": "object", "properties": {"categories": {"type": "array", "items": {"type": "string"}}}, "required": ["categories"]}},
            {"name": "category_of", "description": "Classify an IPv4 address into a category.", "inputSchema": {"type": "object", "properties": {"address": {"type": "string"}}, "required": ["address"]}},
            {"name": "generate_close", "description": "Close and forget a session.", "inputSchema": {"type": "object", "properties": {"session_id": {"type": "string"}}, "required": ["session_id"]}}
          ]
        }
      }
    },
    {
