{
  "_comment": "A worked MCP transcript for ipgen-mcp. Each line is a JSON-RPC 2.0 message; 'in' lines are sent by the client, 'out' lines are returned by the server. Copy-paste-friendly: pipe the 'in' lines (one per line) into ipgen-mcp and you will see the corresponding 'out' lines on stdout.",
  "_handshake": "Client and server exchange protocol version and capabilities.",
  "messages": [
    {
      "direction": "in",
      "message": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
